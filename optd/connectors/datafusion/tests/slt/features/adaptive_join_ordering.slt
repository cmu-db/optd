# Adaptive join-ordering feature coverage.
#
# Before the scalable RelationSet change, the 65- and 101-relation cases failed during
# hypergraph construction at the hard 64-node assertion.

# Small exact DPhyp.
query I
SELECT count(*)
FROM (VALUES (1)) AS t0(x)
JOIN (VALUES (1)) AS t1(x) ON t0.x = t1.x
JOIN (VALUES (1)) AS t2(x) ON t1.x = t2.x
JOIN (VALUES (1)) AS t3(x) ON t2.x = t3.x
JOIN (VALUES (1)) AS t4(x) ON t3.x = t4.x
----
1

# Dense medium graph exceeds the state budget and exercises linearized DP through the complete SQL
# optimization pipeline.
query T
SELECT length(explain_flat('SELECT count(*)
FROM (VALUES (1)) AS t0(x)
JOIN (VALUES (1)) AS t1(x) ON t0.x = t1.x
JOIN (VALUES (1)) AS t2(x) ON t0.x = t2.x AND t1.x = t2.x
JOIN (VALUES (1)) AS t3(x) ON t0.x = t3.x AND t1.x = t3.x AND t2.x = t3.x
JOIN (VALUES (1)) AS t4(x) ON t0.x = t4.x AND t1.x = t4.x AND t2.x = t4.x AND t3.x = t4.x
JOIN (VALUES (1)) AS t5(x) ON t0.x = t5.x AND t1.x = t5.x AND t2.x = t5.x AND t3.x = t5.x AND t4.x = t5.x
JOIN (VALUES (1)) AS t6(x) ON t0.x = t6.x AND t1.x = t6.x AND t2.x = t6.x AND t3.x = t6.x AND t4.x = t6.x AND t5.x = t6.x
JOIN (VALUES (1)) AS t7(x) ON t0.x = t7.x AND t1.x = t7.x AND t2.x = t7.x AND t3.x = t7.x AND t4.x = t7.x AND t5.x = t7.x AND t6.x = t7.x
JOIN (VALUES (1)) AS t8(x) ON t0.x = t8.x AND t1.x = t8.x AND t2.x = t8.x AND t3.x = t8.x AND t4.x = t8.x AND t5.x = t8.x AND t6.x = t8.x AND t7.x = t8.x
JOIN (VALUES (1)) AS t9(x) ON t0.x = t9.x AND t1.x = t9.x AND t2.x = t9.x AND t3.x = t9.x AND t4.x = t9.x AND t5.x = t9.x AND t6.x = t9.x AND t7.x = t9.x AND t8.x = t9.x
JOIN (VALUES (1)) AS t10(x) ON t0.x = t10.x AND t1.x = t10.x AND t2.x = t10.x AND t3.x = t10.x AND t4.x = t10.x AND t5.x = t10.x AND t6.x = t10.x AND t7.x = t10.x AND t8.x = t10.x AND t9.x = t10.x
JOIN (VALUES (1)) AS t11(x) ON t0.x = t11.x AND t1.x = t11.x AND t2.x = t11.x AND t3.x = t11.x AND t4.x = t11.x AND t5.x = t11.x AND t6.x = t11.x AND t7.x = t11.x AND t8.x = t11.x AND t9.x = t11.x AND t10.x = t11.x
JOIN (VALUES (1)) AS t12(x) ON t0.x = t12.x AND t1.x = t12.x AND t2.x = t12.x AND t3.x = t12.x AND t4.x = t12.x AND t5.x = t12.x AND t6.x = t12.x AND t7.x = t12.x AND t8.x = t12.x AND t9.x = t12.x AND t10.x = t12.x AND t11.x = t12.x
JOIN (VALUES (1)) AS t13(x) ON t0.x = t13.x AND t1.x = t13.x AND t2.x = t13.x AND t3.x = t13.x AND t4.x = t13.x AND t5.x = t13.x AND t6.x = t13.x AND t7.x = t13.x AND t8.x = t13.x AND t9.x = t13.x AND t10.x = t13.x AND t11.x = t13.x AND t12.x = t13.x
JOIN (VALUES (1)) AS t14(x) ON t0.x = t14.x AND t1.x = t14.x AND t2.x = t14.x AND t3.x = t14.x AND t4.x = t14.x AND t5.x = t14.x AND t6.x = t14.x AND t7.x = t14.x AND t8.x = t14.x AND t9.x = t14.x AND t10.x = t14.x AND t11.x = t14.x AND t12.x = t14.x AND t13.x = t14.x')) > 0
----
true

# A 15-way star has 2^14 + 14 connected subgraphs, so it exceeds the exact-state budget and
# executes the linearized-DP path without burdening predicate preprocessing.
query I
SELECT count(*)
FROM (VALUES (1)) AS s0(x)
JOIN (VALUES (1)) AS s1(x) ON s0.x = s1.x
JOIN (VALUES (1)) AS s2(x) ON s0.x = s2.x
JOIN (VALUES (1)) AS s3(x) ON s0.x = s3.x
JOIN (VALUES (1)) AS s4(x) ON s0.x = s4.x
JOIN (VALUES (1)) AS s5(x) ON s0.x = s5.x
JOIN (VALUES (1)) AS s6(x) ON s0.x = s6.x
JOIN (VALUES (1)) AS s7(x) ON s0.x = s7.x
JOIN (VALUES (1)) AS s8(x) ON s0.x = s8.x
JOIN (VALUES (1)) AS s9(x) ON s0.x = s9.x
JOIN (VALUES (1)) AS s10(x) ON s0.x = s10.x
JOIN (VALUES (1)) AS s11(x) ON s0.x = s11.x
JOIN (VALUES (1)) AS s12(x) ON s0.x = s12.x
JOIN (VALUES (1)) AS s13(x) ON s0.x = s13.x
JOIN (VALUES (1)) AS s14(x) ON s0.x = s14.x
----
1

