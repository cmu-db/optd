# Mandatory subquery conjuncts use semi/anti joins, not marker CASE filters.
# Include duplicates, nullable keys, empty RHS, and a small q18-shaped HAVING.

statement ok
CREATE TABLE conjunct_lhs (id BIGINT, flag BOOLEAN);

statement ok
CREATE TABLE conjunct_rhs (id BIGINT);

statement ok
INSERT INTO conjunct_lhs VALUES (1, true), (1, true), (2, true), (3, false), (NULL, true);

statement ok
INSERT INTO conjunct_rhs VALUES (1), (1), (NULL);

query I
SELECT id FROM conjunct_lhs
WHERE flag AND id IN (SELECT id FROM conjunct_rhs)
ORDER BY id;
----
1
1

query T
SELECT CASE
  WHEN plan LIKE '%"join_type": "LeftSemi"%'
   AND plan NOT LIKE '%LeftMark%'
   AND plan NOT LIKE '%in_match_mark%'
   AND plan NOT LIKE '%in_unknown_mark%'
  THEN 'ok' ELSE 'bad' END
FROM explain_steps('SELECT id FROM conjunct_lhs WHERE flag AND id IN (SELECT id FROM conjunct_rhs)', 'flat')
WHERE pass = 'SubqueryToJoin';
----
ok

query I
SELECT l.id FROM conjunct_lhs l
WHERE l.flag AND EXISTS (SELECT 1 FROM conjunct_rhs r WHERE r.id = l.id)
ORDER BY l.id;
----
1
1

query I
SELECT l.id FROM conjunct_lhs l
WHERE l.flag AND NOT EXISTS (SELECT 1 FROM conjunct_rhs r WHERE r.id = l.id)
ORDER BY l.id NULLS LAST;
----
2
NULL

# NOT IN must reject unmatched rows when the RHS includes NULL.
query I
SELECT count(*) FROM conjunct_lhs
WHERE flag AND id NOT IN (SELECT id FROM conjunct_rhs);
----
0

# With an empty RHS, even a NULL LHS satisfies NOT IN.
query I
SELECT count(*) FROM conjunct_lhs
WHERE flag AND id NOT IN (SELECT id FROM conjunct_rhs WHERE false);
----
4

query I
SELECT count(*) FROM conjunct_lhs
WHERE flag AND id IN (SELECT id FROM conjunct_rhs WHERE false);
----
0

# Both operands are provably non-null; anti lowering is permitted.
query I
SELECT count(*) FROM conjunct_lhs
WHERE flag AND 99 NOT IN (SELECT id FROM conjunct_rhs WHERE id IS NOT NULL);
----
4

query T
SELECT CASE
  WHEN plan LIKE '%"join_type": "LeftAnti"%'
   AND plan NOT LIKE '%LeftMark%'
  THEN 'ok' ELSE 'bad' END
FROM explain_steps('SELECT id FROM conjunct_lhs WHERE flag AND 99 NOT IN (SELECT id FROM conjunct_rhs WHERE id IS NOT NULL)', 'flat')
WHERE pass = 'SubqueryToJoin';
----
ok

# OR cannot be turned into a semi join: nonmatches can qualify via flag.
query I
SELECT id FROM conjunct_lhs
WHERE flag OR id IN (SELECT id FROM conjunct_rhs)
ORDER BY id NULLS LAST;
----
1
1
2
NULL

query I
SELECT l.id FROM conjunct_lhs l
WHERE l.flag
  AND l.id IN (SELECT id FROM conjunct_rhs)
  AND EXISTS (SELECT 1 FROM conjunct_rhs r WHERE r.id = l.id)
ORDER BY l.id;
----
1
1

statement ok
CREATE TABLE conjunct_items (order_id BIGINT, quantity BIGINT);

statement ok
INSERT INTO conjunct_items VALUES (1, 160), (1, 170), (2, 1), (3, 170), (3, 170);

query II
SELECT l.id, sum(i.quantity)
FROM conjunct_lhs l JOIN conjunct_items i ON l.id = i.order_id
WHERE l.flag AND l.id IN (
  SELECT order_id FROM conjunct_items GROUP BY order_id HAVING sum(quantity) > 300
)
GROUP BY l.id;
----
1 660
